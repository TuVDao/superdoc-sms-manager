<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!--
      A Windows TFM is required: the SMS stack lives in Windows.Devices.Sms, which is only
      projected into managed code when the target framework carries a Windows platform version.
      The previous plain net8.0 target is why the old code had to hunt for WinRT types by
      reflection - and why it silently found nothing at runtime.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!--
      ARM64 matters more than it looks: the laptops most likely to carry a SIM today are the
      Snapdragon X machines and the ThinkPad X13s, and an x64 build only runs there under
      emulation. Following $(Platform) keeps one place to add a target.
    -->
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This project sits at the repository root, so the SDK's default glob would pull in every
      other project's sources - and their obj\ folders, which then collide on generated assembly
      attributes (CS0579). Each sibling project has to be excluded explicitly.
    -->
    <Compile Remove="Cli\**\*.cs" />
    <Compile Remove="WinUI\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="app\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <None Remove="WinUI\**\*" />
    <None Remove="Tools\**\*" />
    <None Remove="Tests\**\*" />
  </ItemGroup>
</Project>
