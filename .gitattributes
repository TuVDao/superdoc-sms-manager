# Normalise line endings so the repo is consistent regardless of who clones it.
# Without this, git warns "LF will be replaced by CRLF" on every add and the diffs
# of Windows scripts churn between machines.
* text=auto eol=lf

# These are launched by Windows itself and must keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Never touch binaries.
*.png  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.msix binary
*.pri  binary
