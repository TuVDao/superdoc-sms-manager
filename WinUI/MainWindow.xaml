<Window
    x:Class="SuperDoc.Sms.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:SuperDoc.Sms.WinUI"
    mc:Ignorable="d"
    Title="SUPERDOC SMS Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="10"
          Padding="16,8,16,16">

        <!-- ================================ APP TITLE BAR ================================ -->
        <!-- Extends into window frame; leaves 135px on right for native Windows caption buttons -->
        <Grid x:Name="AppTitleBar"
              Height="44"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="10"
              Margin="0,0,135,0"
              VerticalAlignment="Center">

            <!-- Sidebar toggle button -->
            <Button Command="{Binding ToggleLeftPanelCommand}"
                    ToolTipService.ToolTip="{Binding Ui.TogglePanelTooltip}"
                    VerticalAlignment="Center"
                    CornerRadius="6"
                    Padding="8,6">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
            </Button>

            <!-- Brand title & compact status badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="SUPERDOC SMS Manager"
                           FontSize="{Binding Ui.TitleFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Compact modem status badge with ellipsis & tooltip -->
                <Border CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="8,3"
                        VerticalAlignment="Center"
                        MaxWidth="180"
                        ToolTipService.ToolTip="{Binding DeviceStatusText}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE88A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  FontSize="11"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding DeviceStatusText}"
                                   FontSize="{Binding Ui.SmallFontSize}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="145" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Navigation & Actions bar aligned to the right -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                <!-- Windows 11 View Switcher Tabs -->
                <Border CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <!-- Messages Tab -->
                        <Button Command="{Binding ShowMessagesCommand}"
                                Background="{Binding IsMessagesView, Converter={StaticResource BoolToNavBackground}}"
                                Foreground="{Binding IsMessagesView, Converter={StaticResource BoolToNavForeground}}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="{Binding Loc.Messages}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Contacts Tab -->
                        <Button Command="{Binding ShowContactsCommand}"
                                Background="{Binding IsContactsView, Converter={StaticResource BoolToNavBackground}}"
                                Foreground="{Binding IsContactsView, Converter={StaticResource BoolToNavForeground}}"
                                BorderThickness="0"
                                CornerRadius="6"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE779;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="{Binding Loc.Contacts}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Check balance button -->
                <Button Click="CheckBalance_Click"
                        ToolTipService.ToolTip="{Binding Loc.BalanceCodeLabel}"
                        CornerRadius="6"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                        <TextBlock Text="{Binding Loc.CheckBalance}" />
                    </StackPanel>
                </Button>

                <!-- Language dropdown - drops down below the control -->
                <local:CustomComboBox ItemsSource="{Binding Ui.LanguageOptions}"
                                      SelectedItem="{Binding Ui.SelectedLanguageOption, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{Binding Loc.LanguageTooltip}"
                                      MinWidth="105"
                                      CornerRadius="6">
                    <local:CustomComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </local:CustomComboBox.ItemTemplate>
                </local:CustomComboBox>

                <!-- Text size dropdown - drops down below the control -->
                <local:CustomComboBox ItemsSource="{Binding Ui.FontSizeOptions}"
                                      SelectedItem="{Binding Ui.SelectedFontSizeOption, Mode=TwoWay}"
                                      ToolTipService.ToolTip="{Binding Loc.FontSizeTooltip}"
                                      MinWidth="95"
                                      CornerRadius="6">
                    <local:CustomComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          FontSize="11"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </local:CustomComboBox.ItemTemplate>
                </local:CustomComboBox>
            </StackPanel>
        </Grid>

        <!-- Status & Notices -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="{Binding Conversations.StatusText}"
                       FontSize="{Binding Ui.SmallFontSize}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <!-- Balance notice warning banner -->
            <Border Background="#7C2D12"
                    BorderBrush="#9A3412"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Visibility="{Binding HasBalanceNotice, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#FFE8D5" />
                    <TextBlock Text="{Binding BalanceNotice}"
                               Foreground="#FFE8D5"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ================================ MESSAGES VIEW ================================ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,*"
              Visibility="{Binding IsMessagesView, Converter={StaticResource BoolToVisibility}}">

            <!-- Left Panel (Thread list card with Mica layered surface) -->
            <Border Width="{Binding Ui.LeftPanelWidth}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Visibility="{Binding Ui.IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">

                    <!-- + New message button -->
                    <Button Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            CornerRadius="8"
                            Command="{Binding Conversations.NewConversationCommand}">
                        <TextBlock Text="{Binding Loc.NewMessage}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>

                    <!-- Search box with magnifying glass icon -->
                    <Grid Grid.Row="1">
                        <TextBox CornerRadius="8"
                                 Padding="32,6,10,6"
                                 PlaceholderText="{Binding Loc.SearchPlaceholder}"
                                 Text="{Binding Conversations.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <FontIcon Glyph="&#xE721;"
                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                  FontSize="13"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  IsHitTestVisible="False" />
                    </Grid>

                    <!-- Delete conversations button -->
                    <Button Grid.Row="2"
                            HorizontalAlignment="Stretch"
                            CornerRadius="8"
                            Margin="0,0,0,4"
                            Command="{Binding Conversations.DeleteSelectedConversationsCommand}"
                            Visibility="{Binding Conversations.HasSelectedConversations, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FF6B6B" />
                            <TextBlock Text="{Binding Conversations.DeleteConversationsLabel}" />
                        </StackPanel>
                    </Button>

                    <!-- Thread list -->
                    <ListView Grid.Row="3"
                              ItemsSource="{Binding Conversations.Conversations}"
                              SelectedItem="{Binding Conversations.SelectedConversation, Mode=TwoWay}"
                              SelectionChanged="ConversationList_SelectionChanged"
                              SelectionMode="Extended">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,8" ColumnSpacing="12">
                                    <!-- Avatar circle with contact initials or crisp vector phone icon -->
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasInitials, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon Glyph="&#xE717;"
                                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding HasInitials, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        </Grid>
                                    </Border>

                                    <!-- Conversation text -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="{Binding HasUnread, Converter={StaticResource UnreadToFontWeight}, ConverterParameter=SemiBold}"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibility}}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastMessagePreview}"
                                                   FontSize="12"
                                                   FontWeight="{Binding HasUnread, Converter={StaticResource UnreadToFontWeight}}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                    </StackPanel>

                                    <!-- Time & Unread / Error badge -->
                                    <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastMessageAtDisplay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right" />

                                        <!-- Unread count pill badge -->
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="9"
                                                MinWidth="20"
                                                Height="18"
                                                Padding="6,0"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding UnreadCount}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Error badge -->
                                        <Border Background="#DC2626"
                                                CornerRadius="9"
                                                Padding="6,2"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="White" />
                                                <TextBlock Text="{Binding DataContext.Loc.ErrorBadge, ElementName=RootGrid}" FontSize="11" Foreground="White" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Drag to resize the thread list -->
            <local:SizerBorder Grid.Column="1"
                               IsHorizontalDrag="True"
                               Width="10"
                               Background="Transparent"
                               PointerPressed="PanelSizer_PointerPressed"
                               PointerMoved="PanelSizer_PointerMoved"
                               PointerReleased="PanelSizer_PointerReleased"
                               PointerCaptureLost="PanelSizer_PointerReleased"
                               ToolTipService.ToolTip="{Binding Loc.PanelSizerTooltip}"
                               Visibility="{Binding Ui.IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Width="2"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:SizerBorder>

            <!-- Right Panel (Thread detail card with Mica layered surface) -->
            <Border Grid.Column="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0,0,0">

                <Grid>
                    <!-- ================= EMPTY STATE PLACEHOLDER ================= -->
                    <Grid Visibility="{Binding Conversations.HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="440">
                            <Border Width="80" Height="80" CornerRadius="40"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          FontSize="36"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Loc.SelectConversation}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Select a conversation from the left to read and send messages, or start a new chat."
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button Command="{Binding Conversations.NewConversationCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Padding="18,8"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding Loc.NewMessage}" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ================= ACTIVE THREAD VIEW ================= -->
                    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                          RowSpacing="8"
                          Visibility="{Binding Conversations.HasSelection, Converter={StaticResource BoolToVisibility}}">

                        <!-- Thread header with avatar, title, subtitle & action buttons -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <!-- Avatar circle -->
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding Conversations.SelectedConversation.Initials}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Conversations.SelectedConversation.HasInitials, Converter={StaticResource BoolToVisibility}}" />
                                    <FontIcon Glyph="&#xE717;"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding Conversations.SelectedConversation.HasInitials, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Conversations.ThreadTitle}"
                                           FontSize="{Binding Ui.HeaderFontSize}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Conversations.ThreadSubtitle}"
                                           FontSize="{Binding Ui.SmallFontSize}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding Conversations.ThreadSubtitle, Converter={StaticResource StringToVisibility}}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{Binding Conversations.DeleteSelectedMessagesCommand}"
                                        CornerRadius="6"
                                        Visibility="{Binding Conversations.HasSelectedMessages, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FF6B6B" />
                                        <TextBlock Text="{Binding Conversations.DeleteMessagesLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddContactForPeerCommand}"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE779;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="{Binding Loc.SaveToContacts}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Subtle divider under header -->
                        <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,4,-16,0" />

                        <!-- Messages list -->
                        <ListView x:Name="ThreadList"
                                  Grid.Row="2"
                                  Padding="4,8"
                                  ItemsSource="{Binding Conversations.ThreadMessages}"
                                  ItemContainerStyle="{StaticResource ThreadBubbleItemStyle}"
                                  SelectionMode="Extended"
                                  SelectionChanged="ThreadList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" HorizontalAlignment="{Binding IsIncoming, Converter={StaticResource IncomingToAlignment}}">
                                        <Border Background="{Binding IsIncoming, Converter={StaticResource IncomingToBrush}}"
                                                CornerRadius="14"
                                                Padding="14,10"
                                                MaxWidth="640">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding Body}"
                                                           FontWeight="{Binding IsUnread, Converter={StaticResource UnreadToFontWeight}}"
                                                           Foreground="White"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding TimestampDisplay}"
                                                               Foreground="#E0E0E0"
                                                               FontSize="12" />
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                                               Foreground="#E0E0E0"
                                                               FontSize="12" />
                                                    <Button Content="{Binding DataContext.Loc.Retry, ElementName=RootGrid}"
                                                            Padding="10,2"
                                                            CornerRadius="4"
                                                            Click="RetryButton_Click"
                                                            Tag="{Binding Id}"
                                                            Visibility="{Binding Status, Converter={StaticResource RetryVisibilityConverter}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           Foreground="#FFD4D4"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Drag to resize the composer -->
                        <local:SizerBorder Grid.Row="3"
                                           IsHorizontalDrag="False"
                                           Height="12"
                                           Background="Transparent"
                                           PointerPressed="ComposerSizer_PointerPressed"
                                           PointerMoved="ComposerSizer_PointerMoved"
                                           PointerReleased="ComposerSizer_PointerReleased"
                                           PointerCaptureLost="ComposerSizer_PointerReleased"
                                           ToolTipService.ToolTip="{Binding Loc.ComposerSizerTooltip}">
                            <Rectangle Height="2"
                                       VerticalAlignment="Center"
                                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        </local:SizerBorder>

                        <!-- Composer section -->
                        <Grid Grid.Row="4"
                              RowDefinitions="Auto,*"
                              RowSpacing="6"
                              Height="{Binding Ui.ComposerHeight}">

                            <TextBox PlaceholderText="{Binding Loc.RecipientPlaceholder}"
                                     Header="{Binding Loc.RecipientHeader}"
                                     CornerRadius="8"
                                     Text="{Binding Conversations.NewRecipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Conversations.CanEditRecipient, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <!-- Emoji Picker Button -->
                                <Button VerticalAlignment="Bottom"
                                        Height="36"
                                        Width="36"
                                        Padding="0"
                                        CornerRadius="8"
                                        ToolTipService.ToolTip="{Binding Loc.EmojiTooltip}">
                                    <FontIcon Glyph="&#xE76E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Button.Flyout>
                                        <Flyout>
                                            <ScrollViewer Height="280" Width="360" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="EmojiGroups" ItemsSource="{Binding EmojiGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Margin="2,0,0,4"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                <GridView ItemsSource="{Binding Emoji}"
                                                                          SelectionMode="None"
                                                                          IsItemClickEnabled="True"
                                                                          ItemClick="Emoji_ItemClick">
                                                                    <GridView.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding}"
                                                                                       FontSize="22"
                                                                                       Margin="4"
                                                                                       HorizontalAlignment="Center" />
                                                                        </DataTemplate>
                                                                    </GridView.ItemTemplate>
                                                                </GridView>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Message input box -->
                                <TextBox x:Name="MessageBox"
                                         Grid.Column="1"
                                         CornerRadius="8"
                                         PlaceholderText="{Binding Loc.MessagePlaceholder}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         VerticalContentAlignment="Top"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Text="{Binding Conversations.MessageBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Send button with icon & proper sizing -->
                                <Button Grid.Column="2"
                                        VerticalAlignment="Bottom"
                                        Height="36"
                                        Padding="16,0"
                                        CornerRadius="8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding Conversations.SendCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE724;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="{Binding Loc.Send}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Counter and warning -->
                        <StackPanel Grid.Row="5"
                                    Spacing="1"
                                    Margin="0,4,0,0">
                            <TextBlock Text="{Binding Conversations.ComposerCounter}"
                                       FontSize="{Binding Ui.CounterFontSize}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Loc.UnicodeWarning}"
                                       FontSize="{Binding Ui.CounterFontSize}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       Visibility="{Binding Conversations.ShowUnicodeWarning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================ CONTACTS VIEW ================================ -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,*"
              Visibility="{Binding IsContactsView, Converter={StaticResource BoolToVisibility}}">

            <!-- Left Panel (Contact list card with Mica layered surface) -->
            <Border Width="{Binding Ui.LeftPanelWidth}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Visibility="{Binding Ui.IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">

                    <!-- + Add contact button -->
                    <Button Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            CornerRadius="8"
                            Command="{Binding ContactBook.NewContactCommand}">
                        <TextBlock Text="{Binding Loc.AddContact}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Button>

                    <!-- Contact list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding ContactBook.Contacts}"
                              SelectedItem="{Binding ContactBook.SelectedContact, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" Padding="4,8" ColumnSpacing="12">
                                    <!-- Avatar circle with contact initials or crisp vector person icon -->
                                    <Border Width="38" Height="38" CornerRadius="19"
                                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}"
                                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasInitials, Converter={StaticResource BoolToVisibility}}" />
                                            <FontIcon Glyph="&#xE779;"
                                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                      FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding HasInitials, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding DisplayPhone}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Note}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Note, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Drag to resize contacts panel -->
            <local:SizerBorder Grid.Column="1"
                               IsHorizontalDrag="True"
                               Width="10"
                               Background="Transparent"
                               PointerPressed="PanelSizer_PointerPressed"
                               PointerMoved="PanelSizer_PointerMoved"
                               PointerReleased="PanelSizer_PointerReleased"
                               PointerCaptureLost="PanelSizer_PointerReleased"
                               ToolTipService.ToolTip="{Binding Loc.PanelSizerTooltip}"
                               Visibility="{Binding Ui.IsLeftPanelVisible, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Width="2"
                           HorizontalAlignment="Center"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:SizerBorder>

            <!-- Right Panel (Contact details / editor card with Mica layered surface) -->
            <Border Grid.Column="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="8,0,0,0">
                <Grid>
                    <!-- Empty state when no contact is selected -->
                    <Grid Visibility="{Binding ContactBook.IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="440">
                            <Border Width="80" Height="80" CornerRadius="40"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE779;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          FontSize="36"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Select a contact"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Choose a contact from the list to view or edit details, or create a new contact."
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Button Command="{Binding ContactBook.NewContactCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Padding="18,8"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding Loc.AddContact}" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Contact editor form when editing -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ContactBook.IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="14"
                                    MaxWidth="580"
                                    HorizontalAlignment="Left">

                            <!-- Contact Header -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                <Border Width="42" Height="42" CornerRadius="21"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <FontIcon Glyph="&#xE779;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              FontSize="18"
                                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Loc.ContactInfo}"
                                               FontSize="{Binding Ui.HeaderFontSize}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Manage contact name and phone number"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBox Header="{Binding Loc.ContactTitle}"
                                     PlaceholderText="{Binding Loc.ContactTitlePlaceholder}"
                                     CornerRadius="8"
                                     Text="{Binding ContactBook.Editor.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Header="{Binding Loc.FamilyName}"
                                     PlaceholderText="{Binding Loc.FamilyNamePlaceholder}"
                                     CornerRadius="8"
                                     Text="{Binding ContactBook.Editor.FamilyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Header="{Binding Loc.GivenName}"
                                     PlaceholderText="{Binding Loc.GivenNamePlaceholder}"
                                     CornerRadius="8"
                                     Text="{Binding ContactBook.Editor.GivenName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Header="{Binding Loc.PhoneNumber}"
                                     PlaceholderText="{Binding Loc.PhonePlaceholder}"
                                     CornerRadius="8"
                                     Text="{Binding ContactBook.Editor.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Header="{Binding Loc.Address}"
                                     PlaceholderText="{Binding Loc.AddressPlaceholder}"
                                     CornerRadius="8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     Text="{Binding ContactBook.Editor.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBox Header="{Binding Loc.Note}"
                                     PlaceholderText="{Binding Loc.NotePlaceholder}"
                                     CornerRadius="8"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="110"
                                     Text="{Binding ContactBook.Editor.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Action buttons with icons -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        MinWidth="110"
                                        Height="36"
                                        CornerRadius="8"
                                        Command="{Binding ContactBook.SaveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                                        <TextBlock Text="{Binding Loc.Save}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button MinWidth="90"
                                        Height="36"
                                        CornerRadius="8"
                                        Command="{Binding ContactBook.DeleteCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="#FF6B6B" />
                                        <TextBlock Text="{Binding Loc.Delete}" />
                                    </StackPanel>
                                </Button>

                                <Button Content="{Binding Loc.Cancel}"
                                        MinWidth="90"
                                        Height="36"
                                        CornerRadius="8"
                                        Command="{Binding ContactBook.CancelCommand}" />
                            </StackPanel>

                            <TextBlock Text="{Binding ContactBook.StatusText}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding ContactBook.StatusText, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
