<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <UseXamlCompilerExecutable>true</UseXamlCompilerExecutable>
    <!-- Gives the executable itself an icon in Explorer, the taskbar and Alt+Tab. The MSIX
         tiles come from the Assets PNGs instead; both are generated from the same source. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GenerateAppxPackageOnBuild)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxBundle>Never</AppxBundle>
    <!-- Symbol packages need mspdbcmf.exe from a full VS install, which this toolchain does not
         have. They are not used for sideloaded testing, so stop warning about them. -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <!--
    The unpackaged build otherwise dies at startup with 0x80670016 unless the machine has the
    Windows App Runtime redistributable installed; the packaged build never hits this because
    it gets the framework as a package dependency. Carrying the SDK next to the exe makes the
    plain build runnable for development without an admin MSIX install each iteration.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    <!-- Tray icon: WinUI 3 has no built-in NotifyIcon, and the app must stay resident to keep
         receiving, so closing the window has to hide it somewhere the user can get it back. -->
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <ProjectReference Include="..\Message_T480s.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!-- The unpackaged build has no ms-appx:// to read the tray icon from, so ship the assets
       next to the executable as well. -->
  <ItemGroup>
    <Content Include="Assets\**" Exclude="@(Content)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!--
      The Assets are already Content items by the time the Include above runs, so its Exclude
      removes them all and the metadata never lands. Update applies to whichever items exist.
      Without CopyToPublishDirectory, `dotnet publish` drops the Assets folder and the tray icon
      fails at runtime with DirectoryNotFoundException.
    -->
    <!-- Translations are read from disk at runtime, so they must reach both the build output
         and the publish output. Adding a language is then a file, not a rebuild. -->
    <Content Include="Strings\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <Content Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
